[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% SET footerjs = 1 %]
[% USE Categories %]
[% PROCESS 'html_helpers.inc' %]
[% PROCESS 'i18n.inc' %]
[% INCLUDE 'doc-head-open.inc' %]
[% FILTER collapse %]
    <title>[% t("Restore deleted patrons") | html %] &rsaquo; [% t("Tools") | html %] &rsaquo; [% t("Koha") | html %]</title>
[% END %]
[% INCLUDE 'doc-head-close.inc' %]
<style nonce="[% Koha.CSPNonce | $raw %]">
    #search_form input[type="text"] {
        width: 30%;
    }
</style>
</head>

<body id="tools_restore_deleted_borrowers" class="tools">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'patron-search-header.inc' %]
[% END %]
[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/tools/tools-home.pl">Tools</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active=1 %]
            <span>Restore deleted patrons</span>
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

<div class="main container-fluid">
    <div class="row">
        <div class="col-md-10 order-md-2 order-sm-1">
            <main>
                <h1>Restore deleted patrons</h1>

                <div id="messages"></div>

                <div class="alert alert-info">
                    <h2><i class="fa fa-exclamation-triangle"></i> Important: Limited restoration</h2>
                    <p><strong>This tool only restores the patron record itself, not related data.</strong></p>
                    <p><strong>The following will NOT be restored because it is permanently deleted:</strong></p>

                    <h4>Circulation & Holdings:</h4>
                    <ul>
                        <li>Holds</li>
                        <li>Recalls</li>
                        <li>Bookings</li>
                        <li>Article requests</li>
                        <li>Curbside pickups</li>
                        <li>Lists</li>
                    </ul>

                    <h4>Patron Settings & Preferences:</h4>
                    <ul>
                        <li>Messaging preferences</li>
                        <li>Patron attributes (extended attributes)</li>
                        <li>Patron image/photo</li>
                    </ul>

                    <h4>History & Records:</h4>
                    <ul>
                        <li>Debarments/restrictions</li>
                        <li>Messages and notices</li>
                        <li>Notification history</li>
                        <li>Discharges</li>
                        <li>Alerts</li>
                        <li>Return claims</li>
                        <li>Item ratings and reviews</li>
                        <li>Last patron records</li>
                    </ul>

                    <h4>Relationships & Memberships:</h4>
                    <ul>
                        <li>Guarantor/guarantee relationships</li>
                        <li>Club enrollments</li>
                        <li>Housebound profile, role, and visits</li>
                    </ul>

                    <h4>Staff Functions:</h4>
                    <ul>
                        <li>ILL requests and comments</li>
                        <li>User permissions</li>
                        <li>ERM counter logs and user roles</li>
                        <li>Cash register actions</li>
                        <li>Acquisitions baskets, budgets, and orders</li>
                        <li>Course instructors</li>
                        <li>Label/card creator batches</li>
                        <li>Advanced editor macros</li>
                        <li>API keys</li>
                    </ul>

                    <h4>Other:</h4>
                    <ul>
                        <li>Subscription routing lists</li>
                        <li>Patron files/attachments</li>
                    </ul>
                </div>

                <div id="search_deleted_borrowers">
                    <form id="search_form">
                        <fieldset class="rows">
                            <legend>Filter deleted patrons:</legend>
                            <ol>
                                <li>
                                    <label for="cardnumber">Cardnumber:</label>
                                    <input type="text" id="cardnumber" name="cardnumber" />
                                </li>
                                <li>
                                    <label for="borrowernumber">Borrowernumber:</label>
                                    <input type="text" id="borrowernumber" name="borrowernumber" />
                                </li>
                                <li>
                                    <label for="firstname">First name:</label>
                                    <input type="text" id="firstname" name="firstname" />
                                </li>
                                <li>
                                    <label for="surname">Surname:</label>
                                    <input type="text" id="surname" name="surname" />
                                </li>
                                <li>
                                    <label for="email">Email:</label>
                                    <input type="text" id="email" name="email" />
                                </li>
                                <li>
                                    <label for="categorycode_filter">Patron category:</label>
                                    <select name="categorycode_filter" id="categorycode_filter" multiple="multiple">
                                        [% FOREACH cat IN Categories.all() %]
                                            <option value="[% cat.categorycode | html %]">[% cat.description | html %]</option>
                                        [% END %]
                                    </select>
                                </li>
                                <li>
                                    <label for="branchcode_filter">Library:</label>
                                    <select name="branchcode_filter" id="branchcode_filter" multiple="multiple">
                                        [% FOREACH lib IN allowed_libraries %]
                                            <option value="[% lib.branchcode | html %]">[% lib.branchname | html %]</option>
                                        [% END %]
                                    </select>
                                </li>
                                <li>
                                    <label for="deleted_from">Deleted after:</label>
                                    <input type="text" size="10" id="deleted_from" name="deleted_from" class="flatpickr" data-date_to="deleted_to" />
                                    <div class="hint">[% INCLUDE 'date-format.inc' %]</div>
                                </li>
                                <li>
                                    <label for="deleted_to">Deleted before:</label>
                                    <input type="text" size="10" id="deleted_to" name="deleted_to" class="flatpickr" />
                                    <div class="hint">[% INCLUDE 'date-format.inc' %]</div>
                                </li>
                            </ol>
                        </fieldset>
                        <fieldset class="action">
                            <input type="submit" class="btn btn-primary" value="Search" />
                            <button type="button" id="clear_filters" class="btn btn-default">Clear</button>
                        </fieldset>
                    </form>
                </div>

                <div id="results_wrapper" class="page-section">
                    <table id="deleted_patrons_table" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th class="NoSort"><input type="checkbox" id="select_all" /></th>
                                <th>Card number</th>
                                <th>Borrowernumber</th>
                                <th>Surname</th>
                                <th>First name</th>
                                <th>Category</th>
                                <th>Library</th>
                                <th>Date deleted</th>
                            </tr>
                        </thead>
                    </table>

                    <fieldset class="action">
                        <button type="button" class="btn btn-primary" id="restore_selected">Restore selected patrons</button>
                    </fieldset>
                </div>
            </main>
        </div>
        <!-- /.col-md-10.order-md-2 -->

        <div class="col-md-2 order-sm-2 order-md-1">
            <aside> [% INCLUDE 'tools-menu.inc' %] </aside>
        </div>
        <!-- /.col-md-2.order-md-1 -->
    </div>
    <!-- /.row -->
</div>
<!-- /.main.container-fluid -->

[% MACRO jsinclude BLOCK %]
    [% INCLUDE 'calendar.inc' %]
    [% Asset.js("js/tools-menu.js") | $raw %]
    [% INCLUDE 'datatables.inc' %]
    [% INCLUDE 'select2.inc' %]
    [% Asset.js("js/pages/restore_deleted_patrons.js") | $raw %]
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]
